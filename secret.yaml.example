---
apiVersion: v1
kind: Secret
metadata:
  name: hermes-secrets
  namespace: hermes
  labels:
    app.kubernetes.io/name: hermes-agent
    app.kubernetes.io/part-of: hermes
type: Opaque
stringData:
  # ── Model Provider (DeepSeek) ──────────────────────────────
  OPENAI_API_KEY: "sk-***"
  DEEPSEEK_API_KEY: "sk-***"

  # ── Telegram Bot ──────────────────────────────────────────
  TELEGRAM_BOT_TOKEN: "***"
  TELEGRAM_ALLOW_ALL_USERS: "true"

  # ── Dashboard Auth ─────────────────────────────────────────
  # HERMES_DASHBOARD_OAUTH_CLIENT_ID: "***"
  # HERMES_DASHBOARD_OAUTH_CLIENT_SECRET: "***"
