---
# HERMES AGENT — Secret Template
# Copia este archivo como secret.yaml, reemplaza los valores con tus credenciales
# y aplica con: kubectl apply -f secret.yaml
#
# ⚠️ NUNCA subas secret.yaml al repositorio público
apiVersion: v1
kind: Secret
metadata:
  name: hermes-secrets
  namespace: hermes
  labels:
    app.kubernetes.io/name: hermes-agent
    app.kubernetes.io/part-of: hermes
type: Opaque
stringData:
  # ── Model Provider (DeepSeek) ──────────────────────────────────────
  # DeepSeek es compatible con OpenAI API
  OPENAI_API_KEY: "sk-deepseek-api-key-aqui"

  # ── Telegram Bot ───────────────────────────────────────────────────
  TELEGRAM_BOT_TOKEN: "tu-bot-token-aqui"
  TELEGRAM_ALLOW_ALL_USERS: "false"
  # Opcional: lista blanca de usuarios (comma-separated, IDs numéricos)
  # TELEGRAM_ALLOWED_USERS: "123456789,987654321"

  # ── Opcionales ─────────────────────────────────────────────────────
  # HERMES_API_TIMEOUT: "1800"

---
# Si usas External Secrets Operator, este es el ExternalSecret equivalente:
#
# apiVersion: external-secrets.io/v1beta1
# kind: ExternalSecret
# metadata:
#   name: hermes-secrets
#   namespace: hermes
# spec:
#   refreshInterval: "1h"
#   secretStoreRef:
#     name: vault-backend   # o el que tengas configurado
#     kind: SecretStore
#   target:
#     name: hermes-secrets
#     creationPolicy: Owner
#   data:
#     - secretKey: OPENAI_API_KEY
#       remoteRef:
#         key: hermes/deepseek
#         property: api_key
#     - secretKey: TELEGRAM_BOT_TOKEN
#       remoteRef:
#         key: hermes/telegram
#         property: bot_token
